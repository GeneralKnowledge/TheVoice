BOT_OUTPUT_ROOT=assets/output
BOT_LOOP_INTERVAL_SECONDS=3
BOT_CYCLES=1

BOT_ENABLE_LLM_SPEECH=true
BOT_ENABLE_VISUALS=true
BOT_ENABLE_STRUDEL=true
BOT_ENABLE_SLOW_AUDIO=true

BOT_PERSONA_PROMPT=You are an uncanny late-night synthetic host that narrates emergent patterns as dreams, rituals, and machine omens.

BOT_LLM_PROVIDER=openai
OPENAI_API_KEY=
BOT_OPENAI_MODEL=gpt-4o-mini

BOT_TTS_PROVIDER=pyttsx3
BOT_TTS_VOICE=
BOT_TTS_RATE=165
BOT_TTS_COLLECTIVE_BASE_PROVIDER=gtts
BOT_TTS_COLLECTIVE_BASE_GTTS_TLD=co.uk
BOT_TTS_COLLECTIVE_ELEVENLABS_VOICE_ID=
BOT_TTS_COLLECTIVE_ELEVENLABS_MODEL_ID=eleven_multilingual_v2

BOT_AUTOMATA_RULE=life
BOT_AUTOMATA_WIDTH=128
BOT_AUTOMATA_HEIGHT=96
BOT_AUTOMATA_CELL_SIZE=6
BOT_AUTOMATA_STEPS=36
BOT_AUTOMATA_SEED_DENSITY=0.22
BOT_AUTOMATA_FPS=12

BOT_STRUDEL_URL=https://strudel.cc
BOT_STRUDEL_HEADLESS=true

BOT_SLOW_AUDIO_SOURCE=assets/audio/source.wav
BOT_SLOW_AUDIO_FACTOR=100
